# === Default LLM (fallback for all agents) ===
MEMORY_LLM_PROVIDER=deepseek

# === Per-Agent LLM Overrides (optional — leave empty to use default) ===
# MEMORY_CRITIC_LLM_PROVIDER=deepseek
# MEMORY_RESEARCHER_LLM_PROVIDER=gemini
# MEMORY_ADVOCATE_LLM_PROVIDER=deepseek
# MEMORY_SENTIMENT_LLM_PROVIDER=gemini
# MEMORY_MACRO_LLM_PROVIDER=gemini

# DeepSeek
MEMORY_DEEPSEEK_API_KEY=sk-your-key
MEMORY_DEEPSEEK_MODEL=deepseek-chat

# Gemini
MEMORY_GEMINI_API_KEY=
MEMORY_GEMINI_MODEL=gemini-2.5-flash

# OpenAI
MEMORY_OPENAI_API_KEY=
MEMORY_OPENAI_MODEL=gpt-4o
MEMORY_OPENAI_BASE_URL=

# Anthropic
MEMORY_ANTHROPIC_API_KEY=
MEMORY_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# AWS Bedrock
MEMORY_AWS_ACCESS_KEY_ID=
MEMORY_AWS_SECRET_ACCESS_KEY=
MEMORY_AWS_REGION=us-east-1
MEMORY_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0

# Ollama
MEMORY_OLLAMA_BASE_URL=http://localhost:11434
MEMORY_OLLAMA_MODEL=llama3.1

# === Telegram (Go Orchestrator) ===
# 1. Create bot: talk to @BotFather on Telegram, send /newbot, get token
# 2. Get chat ID: send /start to your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Fill in below:
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
RELAY_URL=http://localhost:8080

# === LanceDB ===
MEMORY_LANCE_DB_PATH=./data/lancedb

# === Strategy (Paper Trading) ===
# Settings are also editable at /settings in the dashboard UI
SETTINGS_PATH=/data/settings.json
# Tickers to watch (comma-separated, NSE .NS suffix)
STRATEGY_TICKERS=RELIANCE.NS,TATAPOWER.NS,HAL.NS,BEL.NS,SBIN.NS
# Max simultaneous open positions
STRATEGY_MAX_POSITIONS=3
# Max % of wallet per trade
STRATEGY_POSITION_SIZE_PCT=5
# Take profit % (sell when profit reaches this)
STRATEGY_TAKE_PROFIT_PCT=2.0
# Stop loss % (sell when loss reaches this)
STRATEGY_STOP_LOSS_PCT=3.0
# Cooldown between signals per ticker (seconds)
STRATEGY_SIGNAL_COOLDOWN=120
# RSI period for BUY signal calculation
STRATEGY_RSI_PERIOD=14
# RSI below this = oversold (BUY signal)
STRATEGY_RSI_OVERSOLD=55
# RSI above this = overbought (no BUY)
STRATEGY_RSI_OVERBOUGHT=70
# Min price drop % for BUY signal
STRATEGY_MIN_DROP_PCT=0.2
# Force trade every N seconds if no natural signals (0 = disable)
STRATEGY_FORCE_TRADE_SEC=300
# Initial wallet capital (paper)
STRATEGY_INITIAL_CAPITAL=100000

# === SEBI Compliance ===
# Rate limit: max orders per second
SEBI_MAX_OPS=10
