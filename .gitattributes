# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts
*.sh text eol=lf

# Python
*.py text eol=lf
*.pyw text eol=lf

# Rust
*.rs text eol=lf
*.toml text eol=lf

# Go
*.go text eol=lf

# YAML/JSON
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Markdown
*.md text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Archives
*.zip binary
*.tar.gz binary

# Binaries
execution/execution-bin binary
bin/* binary

# Secrets (never track)
.env -text
*.pem -text
stockai-key.pem -text
