FROM lscr.io/linuxserver/code-server:latest

RUN apt-get update && export DEBIAN_FRONTEND=noninteractive && apt-get install -y \
    curl wget git build-essential pkg-config libssl-dev cmake jq \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Python 3.12 + uv
RUN curl -sSL https://github.com/astral-sh/uv/releases/latest/download/uv-x86_64-unknown-linux-gnu.tar.gz | tar xz -C /usr/local/bin --strip-components=1 \
    && chmod +x /usr/local/bin/uv

# Go 1.24
RUN curl -sSL https://go.dev/dl/go1.24.3.linux-amd64.tar.gz | tar -C /usr/local -xzf -
ENV PATH="/usr/local/go/bin:${PATH}" GOPATH="/config/go"

# Rust stable
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && /config/.cargo/bin/rustup component add rustfmt clippy 2>/dev/null || true
ENV PATH="/config/.cargo/bin:${PATH}" CARGO_HOME="/config/.cargo" RUSTUP_HOME="/config/.rustup"

# Docker CLI
RUN curl -sSL https://download.docker.com/linux/static/stable/x86_64/docker-27.5.1.tgz | tar xz -C /tmp \
    && cp /tmp/docker/docker /usr/local/bin/docker \
    && chmod +x /usr/local/bin/docker && rm -rf /tmp/docker

# VS Code extensions
RUN for ext in \
    ms-python.python ms-python.debugpy charliermarsh.ruff \
    golang.go rust-lang.rust-analyzer tamasfe.even-better-toml \
    ms-azuretools.vscode-docker redhat.vscode-yaml; do \
    /app/code-server/bin/code-server --install-extension "$ext" 2>/dev/null || true; \
    done

RUN mkdir -p /config/User && \
    echo '{"workbench.startupEditor":"none","window.restoreWindows":"all"}' > /config/User/settings.json
